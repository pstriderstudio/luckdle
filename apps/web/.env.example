# Copy to apps/web/.env.local (exactly that name) to use the Supabase backend
# instead of the browser playtest. For the local stack, use the Publishable
# key (sb_publishable_…) from `supabase status`. Never put the Secret key
# (sb_secret_…) in the web app: everything here is shipped to browsers.
# "/supabase" goes through the Vite dev proxy to http://127.0.0.1:54321 (see vite.config.ts).
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_ANON_KEY=
# Show the dev tools bar (Next day) against a local backend. Leave unset in production.
VITE_LUCKDLE_DEV_TOOLS=true
