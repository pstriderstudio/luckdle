# Copy to apps/web/.env.local to use the Supabase backend instead of the
# browser playtest. With the local stack (`npm run supabase:start`), the URL
# and anon key are printed by `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Show the dev tools bar (Next day) against a local backend. Leave unset in production.
VITE_LUCKDLE_DEV_TOOLS=true
